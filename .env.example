# -----------------------------------------------------------------------------
# deploi-site public config. All values are optional; the site runs without them.
# -----------------------------------------------------------------------------

# Base URL of deploi-app (no trailing slash), e.g. https://app.getdeploi.com
# When set, every form posts to {VITE_APP_API_URL}/api/public/lead and lands in the CRM.
VITE_APP_API_URL=

# Calendar booking link (Cal.com / Calendly / Google). When set, "Book a call" opens it
# in a new tab; when empty, the button scrolls to the on-page form.
VITE_BOOKING_URL=

# Formspree endpoint (https://formspree.io/f/{FORM_ID}). Fallback used only when
# VITE_APP_API_URL is empty.
VITE_FORMSPREE_ENDPOINT=

# Legal entity name rendered in the Terms page. Renders "Deploi" when empty.
VITE_LEGAL_ENTITY=

# Set to "true" once counsel has reviewed the Terms/Privacy pages to hide the draft badge.
VITE_LEGAL_REVIEWED=
