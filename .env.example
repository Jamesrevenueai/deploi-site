# -----------------------------------------------------------------------------
# Waitlist backend (Formspree). Get from https://formspree.io — create a form,
# copy the endpoint (looks like https://formspree.io/f/{FORM_ID}).
# -----------------------------------------------------------------------------
VITE_FORMSPREE_ENDPOINT=

# -----------------------------------------------------------------------------
# Stripe Payment Link URLs. Every CTA reads these. If empty, the button
# falls back to the on-page #waitlist form so the site never has dead CTAs.
# Create the Payment Links under the LLC in the Stripe dashboard.
# -----------------------------------------------------------------------------
# $750 regular-price AI Audit
VITE_AUDIT_CHECKOUT_URL=
# $375 founding-offer AI Audit (first 5 audits, 50% off)
VITE_AUDIT_FOUNDING_CHECKOUT_URL=
# $297 Founding Cohort Course
VITE_COURSE_CHECKOUT_URL=

# -----------------------------------------------------------------------------
# Cal.com free 15-minute mini-audit booking URL.
# Event: "Free Mini-Audit", 15 min, evenings only, Zoom/Google Meet link.
# -----------------------------------------------------------------------------
VITE_MINI_AUDIT_URL=
