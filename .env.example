# -----------------------------------------------------------------------------
# deploi-site public config. All values are optional; the site runs without them.
# -----------------------------------------------------------------------------

# Base URL of deploi-app (no trailing slash), e.g. https://app.getdeploi.com
# When set, the early access form posts to {VITE_APP_API_URL}/api/public/lead.
VITE_APP_API_URL=

# Formspree endpoint (https://formspree.io/f/{FORM_ID}). Fallback used only when
# VITE_APP_API_URL is empty. With neither set, the form opens the visitor's mail client.
VITE_FORMSPREE_ENDPOINT=

# Legal entity name rendered in the Terms page. Renders "Deploi AI" when empty.
VITE_LEGAL_ENTITY=

# Set to "true" once counsel has reviewed the Terms/Privacy pages to hide the draft badge.
VITE_LEGAL_REVIEWED=
