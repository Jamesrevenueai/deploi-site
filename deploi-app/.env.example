# ----------------------------------------------------------------------------
# deploi-app environment. Copy to .env.local for development.
# Every connector stays off or synthetic until its keys are set.
# ----------------------------------------------------------------------------

# Postgres connection (Supabase: Project Settings -> Database -> Connection string,
# "Transaction" pooler URI; local dev: the container's Postgres).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/deploi_dev

# Supabase Auth (Project Settings -> API).
# The /login dev role picker exists only when ALLOW_DEV_LOGIN=true (default off).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_MODE=dev
ALLOW_DEV_LOGIN=false
# Random 32+ char string used to sign dev sessions and cron/webhook tokens.
APP_SECRET=change-me-to-a-long-random-string

# Who is staff. Comma-separated emails; everyone else who signs in is a store owner.
STAFF_EMAILS=hello@getdeploi.com

# Public URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://getdeploi.com
# Comma-separated origins allowed to POST /api/public/lead
PUBLIC_API_ALLOWED_ORIGINS=https://getdeploi.com,https://www.getdeploi.com

# Email (Resend -> API Keys). From address is always hello@getdeploi.com.
RESEND_API_KEY=
# Agent mailboxes: each agent sends from <name>.<code>@AGENT_MAIL_DOMAIN via Resend (docs/LAUNCH-DNS.md).
AGENT_MAIL_DOMAIN=
# svix signing secret of the Resend webhook for email.received -> /api/webhooks/agent-mail (refuses all without it)
AGENT_MAIL_WEBHOOK_SECRET=
# Real email sends: off (default) | allowlist (only EMAIL_TEST_RECIPIENTS) | all (production, after review)
EMAIL_LIVE_SENDS=off
# System email (invitations, support notices; lib/email/system.ts): sent from hello@<SYSTEM_MAIL_DOMAIN or the
# NEXT_PUBLIC_SITE_URL host> through Resend, under the same EMAIL_LIVE_SENDS gate. That domain must be verified in Resend.
SYSTEM_MAIL_DOMAIN=
# Where staff support notices and website contact messages go (default hello@<site domain>)
SUPPORT_INBOX=
# Signs member invitation links (falls back to APP_SECRET; 32+ characters either way)
INVITE_SECRET=
EMAIL_TEST_RECIPIENTS=
# Gmail / Microsoft 365 connectors: not live-verified, off unless "on"
EMAIL_OAUTH_PROVIDERS=off

# Vercel Cron protection: Vercel sets Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# Shopify app (Partner Dashboard -> Apps -> your app -> Client credentials). docs/SHOPIFY-SETUP.md
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_HANDLE=
SHOPIFY_APP_URL=
# Installed scopes (read only). Default read_products,read_inventory,read_locations; must equal [access_scopes].scopes in shopify.app.toml
SHOPIFY_SCOPES=
# Runtime-requested scopes (write_products,read_publications,write_publications); must equal optional_scopes in the TOML
SHOPIFY_OPTIONAL_SCOPES=
# Encrypts store and mailbox tokens: base64 of 32 random bytes (openssl rand -base64 32)
CREDENTIALS_ENCRYPTION_KEY=
CREDENTIALS_KEY_ID=
# Store access: beta (default) = only development stores, invited or staff-approved stores may be
# written to; open = every installed store (the public listing). LIVE_WRITES=off pauses all writes.
STORE_ACCESS_MODE=beta
LIVE_WRITES=
# Shopify Partner API, to read App Pricing subscriptions (docs/APP-STORE-SUBMISSION.md)
SHOPIFY_PARTNER_ID=
SHOPIFY_PARTNER_APP_ID=
SHOPIFY_PARTNER_API_TOKEN=
# Corrections require an active Shopify subscription when true. Off during early access.
BILLING_REQUIRED=false

# Supabase personal access token, used only by scripts/supabase-http.ts (launch migrations).
SUPABASE_ACCESS_TOKEN=

# Legal acceptance gate (lib/legal): off (default) | draft (pilots accept the labelled DRAFT texts) | enforce (published texts only)
LEGAL_GATE=off
# true: paid pilots must also accept docs/legal/PILOT-BETA-AGREEMENT.md
LEGAL_REQUIRE_PILOT=
# Stripe billing for WooCommerce and Office customers (lib/billing). off = free beta, nothing charged.
# live is refused unless set explicitly, on the production deployment, with a live key. Never commit keys.
BILLING_MODE=off
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
BILLING_GRACE_DAYS=7
# Deploi Office (docs/OFFICE-SETUP.md). Empty: the connect buttons say "needs setup" and the APIs answer 503.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# HUBSPOT_REDIRECT_URL defaults to <APP_URL>/api/office/oauth/hubspot/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URL defaults to <APP_URL>/api/office/oauth/google/callback

# Abuse protection (docs/SECURITY-REVIEW-2026-11-04.md F-12, lib/security/rate-limit.ts). Defaults apply when unset.
# Override one bucket with RATE_LIMIT_<BUCKET>=<limit>/<window seconds>, e.g.:
# RATE_LIMIT_LEAD=6/600
# RATE_LIMIT_MERCHANT_WRITE=600/60
# RATE_LIMITS=off disables every limit (load tests only; never in production)
# Script Content-Security-Policy (F-06, lib/security/csp.ts): enforced by default; report-only sends it as
# Content-Security-Policy-Report-Only (frame-ancestors stays enforced). Optional report endpoint.
# CSP_MODE=report-only
# CSP_REPORT_URI=

# AI gateway (lib/ai/config.ts). off (default) refuses every model call with a clear reason. Model ids and
# prices are configuration only; refer to "the model provider" everywhere else.
AI_PROVIDER=off
AI_ENDPOINT=
AI_API_KEY=
# AI_AUTH_HEADER=x-api-key
# AI_EXTRA_HEADERS={}
AI_MODEL_ROUTINE=
AI_MODEL_COMPLEX=
# USD per million tokens per model id, e.g. {"<routine id>":{"input":0.1,"output":0.5}}
AI_PRICES=
# AI_MAX_INPUT_TOKENS=20000
# AI_MAX_OUTPUT_TOKENS=2000
# AI_MAX_CALLS_PER_AGENT_HOUR=30
# AI_MAX_CALLS_PER_CASE_HOUR=10
# AI_ORG_MONTHLY_USD=15
# Configurable plans (lib/plans/catalog.ts): staff who may approve a price (the owner). Empty: nobody can.
PRICING_APPROVER_EMAILS=
# PLANS_CACHE_MS=60000
# Unit economics estimates for /staff/economics (lib/platform/economics.ts)
# ECON_JOB_RUN_USD=0.0002
# ECON_PROVIDER_CALL_USD=0.0001
# ECON_EMAIL_USD=0.0009
# ECON_TARGET_MIN_USD=15
# ECON_TARGET_MAX_USD=40
# ECON_TARGET_PLAN_USD=249
# Organization deletion and data retention (docs/DATA-RETENTION.md)
# ORG_DELETION_COOLING_OFF_DAYS=7
# RETENTION_EMAIL_BODIES_DAYS=365
# RETENTION_INBOUND_RAW_DAYS=30
# RETENTION_JOBS_DAYS=90
# RETENTION_RATE_LIMIT_DAYS=1
# RETENTION_WEBHOOK_RECEIPTS_DAYS=90
