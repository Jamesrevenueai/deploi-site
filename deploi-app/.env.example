# ----------------------------------------------------------------------------
# deploi-app environment. Copy to .env.local for development.
# Every connector stays off or synthetic until its keys are set.
# ----------------------------------------------------------------------------

# Postgres connection (Supabase: Project Settings -> Database -> Connection string,
# "Transaction" pooler URI; local dev: the container's Postgres).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/deploi_dev

# Supabase Auth (Project Settings -> API).
# The /login dev role picker exists only when ALLOW_DEV_LOGIN=true (default off).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_MODE=dev
ALLOW_DEV_LOGIN=false
# Random 32+ char string used to sign dev sessions and cron/webhook tokens.
APP_SECRET=change-me-to-a-long-random-string

# Who is staff. Comma-separated emails; everyone else who signs in is a store owner.
STAFF_EMAILS=hello@getdeploi.com

# Public URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://getdeploi.com
# Comma-separated origins allowed to POST /api/public/lead
PUBLIC_API_ALLOWED_ORIGINS=https://getdeploi.com,https://www.getdeploi.com

# Email (Resend -> API Keys). From address is always hello@getdeploi.com.
RESEND_API_KEY=
# Agent mailboxes: each agent sends from <name>.<code>@AGENT_MAIL_DOMAIN via Resend (docs/LAUNCH-DNS.md).
AGENT_MAIL_DOMAIN=
# svix signing secret of the Resend webhook for email.received -> /api/webhooks/agent-mail (refuses all without it)
AGENT_MAIL_WEBHOOK_SECRET=
# Real email sends: off (default) | allowlist (only EMAIL_TEST_RECIPIENTS) | all (production, after review)
EMAIL_LIVE_SENDS=off
EMAIL_TEST_RECIPIENTS=
# Gmail / Microsoft 365 connectors: not live-verified, off unless "on"
EMAIL_OAUTH_PROVIDERS=off

# Vercel Cron protection: Vercel sets Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# Shopify app (Partner Dashboard -> Apps -> your app -> Client credentials). docs/SHOPIFY-SETUP.md
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_HANDLE=
SHOPIFY_APP_URL=
# Installed scopes (read only). Default read_products,read_inventory,read_locations; must equal [access_scopes].scopes in shopify.app.toml
SHOPIFY_SCOPES=
# Runtime-requested scopes (write_products,read_publications,write_publications); must equal optional_scopes in the TOML
SHOPIFY_OPTIONAL_SCOPES=
# Encrypts store and mailbox tokens: base64 of 32 random bytes (openssl rand -base64 32)
CREDENTIALS_ENCRYPTION_KEY=
CREDENTIALS_KEY_ID=
# Writes to a live store happen only for stores listed here (comma-separated *.myshopify.com)
LIVE_WRITE_STORES=
# Corrections require an active Shopify subscription when true. Off during early access.
BILLING_REQUIRED=false

# Supabase personal access token, used only by scripts/supabase-http.ts (launch migrations).
SUPABASE_ACCESS_TOKEN=
