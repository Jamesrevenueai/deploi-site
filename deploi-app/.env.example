# ----------------------------------------------------------------------------
# deploi-app environment. Copy to .env.local for development.
# Mock adapters kick in for any empty provider key so the app runs without them.
# ----------------------------------------------------------------------------

# Postgres connection (Supabase: Project Settings -> Database -> Connection string,
# "Transaction" pooler URI; local dev: the container's Postgres).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/deploi_dev

# Supabase Auth (Project Settings -> API). Leave empty to use dev auth
# (AUTH_MODE=dev): a role picker over the seeded users, for local/preview only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_MODE=dev
# Random 32+ char string used to sign dev sessions and cron/webhook tokens.
APP_SECRET=change-me-to-a-long-random-string

# Who is staff. Comma-separated emails; everyone else who signs in is a client.
STAFF_EMAILS=hello@getdeploi.com

# Public URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://getdeploi.com
BOOKING_URL=
# Comma-separated origins allowed to POST /api/public/lead
PUBLIC_API_ALLOWED_ORIGINS=https://getdeploi.com,https://www.getdeploi.com

# Email (Resend -> API Keys). From address is always hello@getdeploi.com.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Staff inbox for the morning pipeline email.
STAFF_NOTIFY_EMAIL=hello@getdeploi.com

# SMS (Twilio console -> Account SID / Auth Token / a purchased number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WEBHOOK_SECRET=

# LLM lanes. `local` is Ollama and is the ONLY lane lib/phi may use.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# cloud lane: openai | anthropic | ollama ; used only for our own sales data
LLM_CLOUD_PROVIDER=
LLM_CLOUD_API_KEY=
LLM_CLOUD_MODEL=
# Set to 1 to return canned responses (tests, offline demos)
LLM_MOCK=

# Smartlead webhook secret (Smartlead -> Settings -> Webhooks)
SMARTLEAD_WEBHOOK_SECRET=

# Vercel Cron protection: Vercel sets Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# Pricing shown on the assessment report
ASSESSMENT_PRICE=$1,500–2,500
BUILD_PRICE_RANGE=$3,000–7,000 per door
RETAINER_RANGE=$500–1,500 / mo

# EVV correction windows in days, per state (JSON). Ohio default 60.
EVV_CORRECTION_WINDOWS={"OH":60,"IN":30,"MI":60,"PA":90}
EVV_DURATION_TOLERANCE_MIN=15

# Storage: Supabase bucket for assessment PDFs. Local fallback: ./.storage
STORAGE_BUCKET=reports
