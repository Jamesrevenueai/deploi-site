# "Deploi (dev)": the development-store app, kept separate from any future production app.
# Create it once with the CLI, which writes the real file from the Dev Dashboard record:
#   shopify app config link --client-id <client id from Dev Dashboard, org "deploi ai"> --file-name shopify.app.deploi-dev.toml
# Then: shopify app dev --config deploi-dev --store james-jwtftl1e.myshopify.com
# Never commit shopify.app.deploi-dev.toml itself (it carries the live client_id) or the client secret.
client_id = "<SHOPIFY_API_KEY of Deploi (dev)>"
name = "Deploi (dev)"
handle = "deploi-dev"
application_url = "https://<tunnel or app host>/shopify"
embedded = true

[build]
automatically_update_urls_on_dev = true
dev_store_url = "james-jwtftl1e.myshopify.com"

[access_scopes]
# Installed with the app: read only. Enough for every template at "drafts only" (lib/connectors/shopify/config.ts REQUIRED_SCOPES).
scopes = "read_products,read_inventory,read_locations"
# Asked for at runtime through App Bridge (shopify.scopes.request) only when a merchant widens an agent past drafts only:
#   write_products        Inventory Watcher after "after my approval" / "without asking" ("Continue selling when out of stock" On -> Off), price and SKU corrections
#   read_publications,    publication correction only (which sales channels a product is on; publish / unpublish)
#   write_publications
# Must match OPTIONAL_SCOPES in config.ts. No customer, order, report or inventory-write scope anywhere.
optional_scopes = ["write_products", "read_publications", "write_publications"]
use_legacy_install_flow = false

[auth]
redirect_urls = ["https://<tunnel or app host>/api/shopify/auth/callback"]

[webhooks]
api_version = "2026-10"

  [[webhooks.subscriptions]]
  topics = ["app/uninstalled", "app/scopes_update", "products/update", "products/delete", "inventory_levels/update", "inventory_items/update"]
  uri = "/api/shopify/webhooks"

  [[webhooks.subscriptions]]
  compliance_topics = ["customers/data_request", "customers/redact", "shop/redact"]
  uri = "/api/shopify/webhooks"

[pos]
embedded = false
