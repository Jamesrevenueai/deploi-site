{
  "ignoreCommand": "P=${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}; [ \"$(git rev-parse \"$P\" 2>/dev/null)\" = \"$(git rev-parse HEAD)\" ] && exit 1; git cat-file -e \"$P^{commit}\" 2>/dev/null || exit 1; git diff --quiet \"$P\" HEAD -- .",
  "crons": [
    {
      "path": "/api/cron/agents",
      "schedule": "7 * * * *"
    },
    {
      "path": "/api/cron/weekly-summary",
      "schedule": "13 13 * * 1"
    },
    {
      "path": "/api/cron/library",
      "schedule": "23 * * * *"
    },
    {
      "path": "/api/cron/jobs",
      "schedule": "41 * * * *"
    },
    {
      "path": "/api/cron/office",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/alerts",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "17 4 * * *"
    },
    {
      "path": "/api/cron/health",
      "schedule": "29 * * * *"
    },
    {
      "path": "/api/cron/daily-report",
      "schedule": "11 12 * * *"
    },
    {
      "path": "/api/cron/sweep",
      "schedule": "*/15 * * * *"
    }
  ]
}
