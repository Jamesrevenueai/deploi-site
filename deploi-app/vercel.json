{
  "ignoreCommand": "P=${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}; git cat-file -e \"$P^{commit}\" 2>/dev/null || exit 1; git diff --quiet \"$P\" HEAD -- .",
  "crons": [
    {
      "path": "/api/cron/agents",
      "schedule": "7 * * * *"
    },
    {
      "path": "/api/cron/weekly-summary",
      "schedule": "13 13 * * 1"
    },
    {
      "path": "/api/cron/library",
      "schedule": "23 * * * *"
    },
    {
      "path": "/api/cron/jobs",
      "schedule": "41 * * * *"
    },
    {
      "path": "/api/cron/office",
      "schedule": "*/15 * * * *"
    }
  ]
}
